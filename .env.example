# Development defaults — copy to .env and adjust as needed.
# For production (Vercel + Neon), see notes below each variable.

POSTGRES_USER=setlist
POSTGRES_PASSWORD=setlist          # Local dev only — Neon manages its own credentials in production
POSTGRES_DB=setlistdb

# Prisma's runtime connection (pooled). Used by lib/prisma.ts via @prisma/adapter-neon.
# Development: points at the local Docker Postgres container. Host port is 5433, not the
# Postgres default 5432, to avoid colliding with other Hive projects' local DB containers
# (e.g. coffee-shop already binds 5432) — no pooler involved either way in dev.
# Production: the pooled Neon connection string, set automatically by the Vercel
# Marketplace Neon integration — do not set manually on Vercel.
DATABASE_URL=postgresql://setlist:setlist@localhost:5433/setlistdb

# Prisma CLI's migration connection (unpooled/direct) — see prisma.config.ts.
# Development: same as DATABASE_URL, since the local Postgres container has no pooler.
# Production: Neon's direct/unpooled connection string (also set by the Vercel
# Marketplace integration) — migrations need session-level features Neon's pgbouncer
# pooler doesn't support.
DIRECT_DATABASE_URL=postgresql://setlist:setlist@localhost:5433/setlistdb

NODE_ENV=development   # Production: set to production (Vercel sets this automatically)

# The single shared password gating the whole app (see middleware.ts and lib/auth.ts) —
# this app has no real user accounts, just one password everyone enters once.
# Development: set to anything, e.g. dev-password.
# Production: set a real secret in Vercel's project environment variables — rotating it
# invalidates every existing login cookie at once, which is the intended "force re-login" path.
SITE_PASSWORD=dev-password
